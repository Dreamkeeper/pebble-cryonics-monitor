# Pebble
watchapp/build/
watchapp/.pebble-*
*.pbw

# C host tests
watchapp/tests/*.exe
watchapp/tests/*.o
watchapp/tests/test_runner

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
server/data/*.db

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Secrets — never commit
*.env
!.env.example
secrets.*
config.local.*
watchapp/tests/*.obj

# Built artifacts are ignored everywhere except dist/
!dist/*.pbw
!dist/*.apk
watchapp/.lock-waf*
tokens.txt

# Release signing — never commit
*.jks
*.keystore
android/keystore.properties
