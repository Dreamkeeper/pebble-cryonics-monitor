# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Admin credential for wearer administration (create wearers, issue
# enrollment codes, edit any wearer's contacts) until the web dashboard
# lands. Generate: openssl rand -hex 32
CM_ADMIN_TOKEN=

# LEGACY (pre-multi-wearer): on first boot with an empty database this
# token is migrated into wearer 'default' so an already-configured phone
# keeps working. New deployments can leave it empty and enroll instead.
CM_API_TOKEN=

# Public base URL (used to build acknowledge links in messages).
CM_PUBLIC_URL=https://cm.example.com

# Telegram bot for contact alerts with ACK buttons (via @BotFather).
# Also enables the acknowledgement long-poll task.
CM_TELEGRAM_BOT_TOKEN=

# SMTP for email alerts (optional).
CM_SMTP_HOST=
CM_SMTP_PORT=587
CM_SMTP_USER=
CM_SMTP_PASSWORD=
CM_SMTP_FROM=cryomonitor@example.com

# ntfy push. Default uses the bundled self-hosted ntfy container;
# set to https://ntfy.sh to use the public instance instead.
CM_NTFY_URL=http://ntfy

# Where the SQLite database lives (bind-mounted volume in compose).
CM_DATA_DIR=/srv/data

# Enrollment code lifetime in seconds (default 24 h).
CM_ENROLL_TTL_S=86400

# Log verbosity: INFO for normal operation, DEBUG for extensive logs
# (every heartbeat, dead-man evaluation transitions, all sends).
CM_LOG_LEVEL=INFO

# Optional outbound HTTP(S) proxy for Telegram API calls, for networks
# where api.telegram.org is blocked. Hostnames in CM_NO_PROXY bypass it.
CM_OUTBOUND_PROXY=
CM_NO_PROXY=ntfy,localhost,127.0.0.1
