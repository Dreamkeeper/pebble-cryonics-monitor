# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Shared secret between the Android companion and this server.
# Generate one: openssl rand -hex 32
CM_API_TOKEN=

# Telegram bot for contact alerts with ACK buttons (via @BotFather).
CM_TELEGRAM_BOT_TOKEN=

# SMTP for email alerts (optional).
CM_SMTP_HOST=
CM_SMTP_PORT=587
CM_SMTP_USER=
CM_SMTP_PASSWORD=
CM_SMTP_FROM=cryomonitor@example.com

# ntfy push. Default uses the bundled self-hosted ntfy container;
# set to https://ntfy.sh to use the public instance instead.
CM_NTFY_URL=http://ntfy

# Log verbosity: INFO for normal operation, DEBUG for extensive logs
# (every heartbeat, dead-man evaluation transitions, all sends).
CM_LOG_LEVEL=INFO
